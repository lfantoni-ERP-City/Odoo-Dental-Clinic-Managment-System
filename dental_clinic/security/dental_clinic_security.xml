<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_dental_clinic" model="ir.module.category">
        <field name="name">Clínica Dental</field>
        <field name="sequence">30</field>
    </record>

    <record id="group_dental_clinic_user" model="res.groups">
        <field name="name">Usuario de clínica</field>
        <field name="category_id" ref="dental_clinic.module_category_dental_clinic"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_dental_clinic_manager" model="res.groups">
        <field name="name">Administrador de clínica</field>
        <field name="category_id" ref="dental_clinic.module_category_dental_clinic"/>
        <field name="implied_ids" eval="[(4, ref('dental_clinic.group_dental_clinic_user'))]"/>
    </record>

    <record id="rule_dental_patient_company" model="ir.rule">
        <field name="name">Pacientes por compañía</field><field name="model_id" ref="model_dental_patient"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('dental_clinic.group_dental_clinic_user'))]"/>
    </record>
    <record id="rule_dental_doctor_company" model="ir.rule">
        <field name="name">Odontólogos por compañía</field><field name="model_id" ref="model_dental_doctor"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('dental_clinic.group_dental_clinic_user'))]"/>
    </record>
    <record id="rule_dental_appointment_company" model="ir.rule">
        <field name="name">Citas por compañía</field><field name="model_id" ref="model_dental_appointment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('dental_clinic.group_dental_clinic_user'))]"/>
    </record>
    <record id="rule_dental_procedure_company" model="ir.rule">
        <field name="name">Procedimientos por compañía</field><field name="model_id" ref="model_dental_procedure_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('dental_clinic.group_dental_clinic_user'))]"/>
    </record>
    <record id="rule_dental_attachment_company" model="ir.rule">
        <field name="name">Adjuntos por compañía</field><field name="model_id" ref="model_dental_attachment_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('dental_clinic.group_dental_clinic_user'))]"/>
    </record>
    <record id="rule_dental_prescription_company" model="ir.rule">
        <field name="name">Prescripciones por compañía</field><field name="model_id" ref="model_dental_prescription"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('dental_clinic.group_dental_clinic_user'))]"/>
    </record>
    <record id="rule_dental_prescription_line_company" model="ir.rule">
        <field name="name">Detalles de prescripción por compañía</field><field name="model_id" ref="model_dental_prescription_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('dental_clinic.group_dental_clinic_user'))]"/>
    </record>
</odoo>
