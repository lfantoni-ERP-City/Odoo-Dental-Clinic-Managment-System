<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_dental_patient" model="ir.sequence">
        <field name="name">Historia clínica odontológica</field><field name="code">dental.patient</field>
        <field name="prefix">HC-%(year)s-</field><field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_dental_appointment" model="ir.sequence">
        <field name="name">Cita odontológica</field><field name="code">dental.appointment</field>
        <field name="prefix">CD-%(year)s-</field><field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_dental_prescription" model="ir.sequence">
        <field name="name">Prescripción odontológica</field><field name="code">dental.prescription</field>
        <field name="prefix">PO-%(year)s-</field><field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
